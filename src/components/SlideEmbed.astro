---
/**
 * スライド埋め込み。
 *  - provider="speakerdeck": src に https://speakerdeck.com/player/<ID> を指定
 *  - provider="google":      src に Google スライドの「埋め込み」URL（/embed?...）を指定
 *  - provider="pdf":         src に public/slides/xxx.pdf のパスを指定
 *  - provider="iframe":      任意の埋め込み URL
 * link を渡すと「Speaker Deck ↗」のような外部リンクを表示します。
 */
import { withBase } from '../lib/url';
interface Props { provider?: 'speakerdeck' | 'google' | 'pdf' | 'iframe'; src: string; title?: string; caption?: string; link?: string; ratio?: string; }
const { provider = 'iframe', src, title = 'Slides', caption, link, ratio = '16 / 9' } = Astro.props;
const providerLabel = { speakerdeck: 'Speaker Deck', google: 'Google Slides', pdf: 'PDF', iframe: 'Open' }[provider];
const url = provider === 'pdf' ? withBase(src) : src;
---
<figure class="slide-embed">
  <div class="slide-embed__frame" style={`aspect-ratio: ${ratio}`}>
    <iframe src={url} title={title} loading="lazy" allowfullscreen allow="fullscreen"></iframe>
  </div>
  <div class="slide-embed__bar">
    <span class="t-caption slide-embed__title">{title}</span>
    {link && <a href={link} target="_blank" rel="noopener" class="t-nav slide-embed__link">{providerLabel} ↗</a>}
  </div>
  {caption && <figcaption class="t-caption c-muted">{caption}</figcaption>}
</figure>
<style>
  .slide-embed { display: flex; flex-direction: column; gap: 0; }
  .slide-embed__frame { background: var(--color-ink); border-radius: var(--radius) var(--radius) 0 0; overflow: hidden; }
  .slide-embed__frame iframe { width: 100%; height: 100%; border: 0; }
  .slide-embed__bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 16px; background: color-mix(in srgb, var(--color-ink) 92%, #fff); color: #fff; border-radius: 0 0 var(--radius) var(--radius); }
  .slide-embed__title { color: var(--color-line); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .slide-embed__link { color: #fff; flex-shrink: 0; }
  .slide-embed figcaption { margin-top: 12px; }
</style>
