---
interface Props { category: string; period: string; title: string; description: string; url?: string; }
const { category, period, title, description, url } = Astro.props;
const Tag = url ? 'a' : 'div';
---
<Tag class="activity reveal" {...(url ? { href: url, target: '_blank', rel: 'noopener' } : {})}>
  <div class="activity__top">
    <span class="t-label c-accent">{category}</span>
    <span class="t-num c-muted">{period}</span>
  </div>
  <h3 class="t-h3">{title}</h3>
  <p class="t-body c-muted">{description}</p>
</Tag>
<style>
  .activity { display: flex; flex-direction: column; gap: 14px; padding: 28px; background: var(--color-surface); border-radius: var(--radius); transition: transform 0.3s var(--ease), box-shadow 0.3s; }
  a.activity:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(15, 36, 71, 0.08); }
  .activity__top { display: flex; justify-content: space-between; align-items: center; }
</style>
