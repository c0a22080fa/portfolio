---
interface Props { date: string; title: string; description?: string; url?: string; }
const { date, title, description, url } = Astro.props;
---
<li class="exp-row">
  <span class="t-num c-accent exp-row__date">{date}</span>
  <div class="exp-row__body">
    <p class="t-h3">{url ? <a href={url} target="_blank" rel="noopener" class="exp-row__link">{title}</a> : title}</p>
    {description && <p class="t-body c-muted">{description}</p>}
  </div>
</li>
<style>
  .exp-row { display: grid; gap: 8px; padding-block: 20px; border-bottom: 1px solid var(--color-line); }
  .exp-row__body { display: flex; flex-direction: column; gap: 6px; }
  .exp-row__link { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--color-line); }
  .exp-row__link:hover { color: var(--color-accent); text-decoration-color: currentColor; }
  @media (min-width: 960px) {
    .exp-row { grid-template-columns: 208px minmax(0, 1fr); gap: 32px; padding-block: 28px; }
    .exp-row__date { padding-top: 4px; }
  }
</style>
